# ===============================
# ETAPA 1: CONSTRUCCIÓN (BUILD)
# ===============================
# Usamos una imagen de Maven que tenga Java 21
FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /app

# Copiamos solo el pom.xml primero para aprovechar la caché de Docker
COPY pom.xml .
# Descargamos dependencias (esto hace que las siguientes builds sean rápidas)
# Si falla, puedes comentar esta línea, pero es recomendada
RUN mvn dependency:go-offline -B

# Copiamos el código fuente
COPY src ./src

# Empaquetamos el .jar saltando los tests (para evitar errores de conexión a BDs externas durante el build)
RUN mvn clean package -DskipTests

# ===============================
# ETAPA 2: EJECUCIÓN (RUN)
# ===============================
# Usamos Java 21 Alpine (versión ligera para producción)
FROM eclipse-temurin:21-jdk-alpine
WORKDIR /app

# Copiamos el JAR generado en la etapa anterior
# El nombre suele ser backend-sp-0.0.1-SNAPSHOT.jar, el asterisco * lo encuentra solo
COPY --from=build /app/target/*.jar app.jar

# Exponemos el puerto 8080
EXPOSE 8080

# Comando para iniciar la aplicación
ENTRYPOINT ["java", "-jar", "app.jar"]